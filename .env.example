# groq (default) or anthropic
# The incident runs need anthropic: Groq's free tier cannot hold a full run.
PROVIDER=groq
GROQ_API_KEY=XXXX
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
ANTHROPIC_API_KEY=XXXX
# ANTHROPIC_MODEL=claude-haiku-5-5
# Spans of every run go here (OTLP JSON lines). Local only.
# TRACE_FILE=runs/traces.jsonl
