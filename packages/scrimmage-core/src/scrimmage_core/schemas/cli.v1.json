{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scrimmage:schema:cli:v1",
  "title": "Scrimmage --json output, version 1",
  "description": "The one JSON document a scrimmage command prints with --json. Every command's document starts with the same envelope. Within version 1, fields and enum values are only added, so this schema is open: an unknown field, and an unknown value of a field that lists its values, both fit. A reader ignores a field it does not know and reads such a value as other.",
  "allOf": [
    {
      "$ref": "#/$defs/envelope"
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "test"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/test"
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "check"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/check"
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "record"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/record"
      }
    }
  ],
  "$defs": {
    "message": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "description": "The line's text, without its prefix. It can change in any release; do not match on it."
        }
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "scrimmage": {
      "type": "string",
      "minLength": 1,
      "description": "The installed Scrimmage version."
    },
    "exit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "The process's exit code."
    },
    "dollars": {
      "type": "number",
      "minimum": 0
    },
    "test": {
      "type": "object",
      "required": [
        "v",
        "scrimmage",
        "command",
        "exit",
        "status",
        "config",
        "records",
        "tests",
        "rows",
        "cost_usd",
        "budget_usd",
        "stopped_by",
        "mistakes",
        "notes",
        "warnings",
        "infra"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "scrimmage": {
          "$ref": "#/$defs/scrimmage"
        },
        "command": {
          "enum": [
            "test"
          ]
        },
        "exit": {
          "$ref": "#/$defs/exit"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "passed",
                "failed",
                "mistake",
                "infra"
              ]
            },
            {
              "type": "string",
              "$comment": "open: a value this release does not know; read as other"
            }
          ]
        },
        "config": {
          "type": "string"
        },
        "records": {
          "type": [
            "string",
            "null"
          ],
          "description": "The folder that holds this test's records, or null when none was made."
        },
        "tests": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "cost_usd": {
          "$ref": "#/$defs/dollars"
        },
        "budget_usd": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/dollars"
            }
          ]
        },
        "stopped_by": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "budget",
                "budget_held",
                "no_price",
                "unknown_tool_type",
                "unseen_tool",
                "structure",
                "ambiguous_label",
                "unknown_label"
              ]
            },
            {
              "type": "string",
              "$comment": "open: a value this release does not know; read as other"
            }
          ]
        },
        "mistakes": {
          "$ref": "#/$defs/messages"
        },
        "notes": {
          "$ref": "#/$defs/messages"
        },
        "warnings": {
          "$ref": "#/$defs/messages"
        },
        "infra": {
          "$ref": "#/$defs/messages"
        }
      }
    },
    "row": {
      "type": "object",
      "required": [
        "test",
        "row",
        "fault",
        "runs",
        "fired",
        "done",
        "passed",
        "judged",
        "rate",
        "range",
        "pass_rate",
        "tools",
        "cost_usd",
        "result",
        "broken",
        "run_details"
      ],
      "properties": {
        "test": {
          "type": "string"
        },
        "row": {
          "type": "string"
        },
        "fault": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "call",
                "do",
                "when",
                "model",
                "method",
                "path",
                "raises"
              ],
              "properties": {
                "call": {
                  "type": "string"
                },
                "do": {
                  "type": "string"
                },
                "when": {
                  "type": "string"
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "method": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "raises": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "runs": {
          "type": "integer",
          "minimum": 0
        },
        "fired": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "judged": {
          "type": "integer",
          "minimum": 0
        },
        "rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "range": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          ]
        },
        "pass_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "tools": {
          "type": "number",
          "minimum": 0
        },
        "cost_usd": {
          "$ref": "#/$defs/dollars"
        },
        "result": {
          "anyOf": [
            {
              "enum": [
                "pass",
                "fail",
                "no result"
              ]
            },
            {
              "type": "string",
              "$comment": "open: a value this release does not know; read as other"
            }
          ]
        },
        "broken": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "text",
              "runs"
            ],
            "properties": {
              "kind": {
                "anyOf": [
                  {
                    "enum": [
                      "expect",
                      "forbid",
                      "empty",
                      "crashed",
                      "timed out",
                      "refused"
                    ]
                  },
                  {
                    "type": "string",
                    "$comment": "open: a value this release does not know; read as other"
                  }
                ]
              },
              "text": {
                "type": "string"
              },
              "runs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "run_details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "run",
        "outcome",
        "fault_fired",
        "judged",
        "left_out",
        "cost_usd",
        "answer_preview"
      ],
      "properties": {
        "run": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "fault_fired": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "judged": {
          "anyOf": [
            {
              "enum": [
                "pass",
                "fail",
                "left out"
              ]
            },
            {
              "type": "string",
              "$comment": "open: a value this release does not know; read as other"
            }
          ]
        },
        "left_out": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost_usd": {
          "$ref": "#/$defs/dollars"
        },
        "answer_preview": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "v",
        "scrimmage",
        "command",
        "exit",
        "status",
        "config",
        "summary",
        "mistakes",
        "notes",
        "warnings",
        "infra"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "scrimmage": {
          "$ref": "#/$defs/scrimmage"
        },
        "command": {
          "enum": [
            "check"
          ]
        },
        "exit": {
          "$ref": "#/$defs/exit"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "valid",
                "mistake",
                "infra"
              ]
            },
            {
              "type": "string",
              "$comment": "open: a value this release does not know; read as other"
            }
          ]
        },
        "config": {
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "tests",
                "rows",
                "runs",
                "tools",
                "budget_usd"
              ],
              "properties": {
                "tests": {
                  "type": "integer",
                  "minimum": 1
                },
                "rows": {
                  "type": "integer",
                  "minimum": 1
                },
                "runs": {
                  "type": "integer",
                  "minimum": 1
                },
                "tools": {
                  "type": "integer",
                  "minimum": 0
                },
                "budget_usd": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/dollars"
                    }
                  ]
                }
              }
            }
          ]
        },
        "mistakes": {
          "$ref": "#/$defs/messages"
        },
        "notes": {
          "$ref": "#/$defs/messages"
        },
        "warnings": {
          "$ref": "#/$defs/messages"
        },
        "infra": {
          "$ref": "#/$defs/messages"
        }
      }
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "answered",
            "crashed",
            "timed out",
            "refused call",
            "budget reached",
            "not reserved",
            "infrastructure error",
            "stopped"
          ]
        },
        {
          "type": "string",
          "$comment": "open: a value this release does not know; read as other"
        }
      ]
    },
    "record": {
      "type": "object",
      "required": [
        "v",
        "scrimmage",
        "command",
        "exit",
        "status",
        "config",
        "out",
        "records",
        "cost_usd",
        "numbers",
        "tests",
        "mistakes",
        "notes",
        "warnings",
        "infra"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "scrimmage": {
          "$ref": "#/$defs/scrimmage"
        },
        "command": {
          "enum": [
            "record"
          ]
        },
        "exit": {
          "$ref": "#/$defs/exit"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "complete",
                "incomplete",
                "mistake",
                "infra"
              ]
            },
            {
              "type": "string",
              "$comment": "open: a value this release does not know; read as other"
            }
          ]
        },
        "config": {
          "type": "string"
        },
        "out": {
          "type": [
            "string",
            "null"
          ],
          "description": "The file written, whole, or null when nothing was written."
        },
        "records": {
          "type": [
            "string",
            "null"
          ],
          "description": "The folder that holds this record's run, or null when no run started."
        },
        "cost_usd": {
          "$ref": "#/$defs/dollars"
        },
        "numbers": {
          "type": "object",
          "required": [
            "calls_seen",
            "calls_written"
          ],
          "properties": {
            "calls_seen": {
              "type": "integer",
              "minimum": 0
            },
            "calls_written": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_test"
          }
        },
        "mocks_text": {
          "type": "string",
          "description": "The mocks, when the file's layout could not take them."
        },
        "mistakes": {
          "$ref": "#/$defs/messages"
        },
        "notes": {
          "$ref": "#/$defs/messages"
        },
        "warnings": {
          "$ref": "#/$defs/messages"
        },
        "infra": {
          "$ref": "#/$defs/messages"
        }
      }
    },
    "envelope": {
      "type": "object",
      "required": [
        "v",
        "scrimmage",
        "command",
        "exit",
        "status",
        "config",
        "mistakes",
        "notes",
        "warnings",
        "infra"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "scrimmage": {
          "$ref": "#/$defs/scrimmage"
        },
        "command": {
          "anyOf": [
            {
              "enum": [
                "test",
                "check",
                "record"
              ]
            },
            {
              "type": "string",
              "$comment": "open: a value this release does not know; read as other"
            }
          ]
        },
        "exit": {
          "$ref": "#/$defs/exit"
        },
        "status": {
          "type": "string"
        },
        "config": {
          "type": "string"
        },
        "mistakes": {
          "$ref": "#/$defs/messages"
        },
        "notes": {
          "$ref": "#/$defs/messages"
        },
        "warnings": {
          "$ref": "#/$defs/messages"
        },
        "infra": {
          "$ref": "#/$defs/messages"
        }
      }
    },
    "removal": {
      "type": "object",
      "required": [
        "key",
        "rule"
      ],
      "properties": {
        "key": {
          "type": [
            "string",
            "null"
          ],
          "description": "The key a value was under, or null for a pattern match in plain text."
        },
        "rule": {
          "anyOf": [
            {
              "enum": [
                "pattern",
                "key_name"
              ]
            },
            {
              "type": "string",
              "$comment": "open: a value this release does not know; read as other"
            }
          ],
          "description": "pattern: the existing redaction; key_name: the key-name heuristic."
        }
      }
    },
    "written_mock": {
      "type": "object",
      "required": [
        "call",
        "method",
        "path",
        "calls",
        "removed"
      ],
      "properties": {
        "call": {
          "type": "string"
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "calls": {
          "type": "integer",
          "minimum": 1
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/removal"
          }
        }
      }
    },
    "kept_mock": {
      "type": "object",
      "required": [
        "call",
        "mock"
      ],
      "properties": {
        "call": {
          "type": "string"
        },
        "mock": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "skipped_call": {
      "type": "object",
      "required": [
        "call",
        "method",
        "path",
        "code",
        "calls"
      ],
      "properties": {
        "call": {
          "type": "string"
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "anyOf": [
            {
              "enum": [
                "outside_tool",
                "credential"
              ]
            },
            {
              "type": "string",
              "$comment": "open: a value this release does not know; read as other"
            }
          ]
        },
        "calls": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "manual_call": {
      "type": "object",
      "required": [
        "call",
        "code",
        "method",
        "path",
        "calls",
        "message",
        "instead"
      ],
      "properties": {
        "call": {
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "enum": [
                "refused",
                "raised",
                "status",
                "differs",
                "nondeterministic",
                "unsavable",
                "null",
                "placeholder",
                "too_large",
                "binary",
                "incomplete_reply",
                "secret_changed_shape",
                "model_inside",
                "not_finished"
              ]
            },
            {
              "type": "string",
              "$comment": "open: a value this release does not know; read as other"
            }
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "calls": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "type": "string"
        },
        "instead": {
          "type": [
            "string",
            "null"
          ],
          "description": "The mock written in this call's place, so it needs nothing from the team, or null."
        }
      }
    },
    "record_test": {
      "type": "object",
      "required": [
        "test",
        "run",
        "outcome",
        "written",
        "kept",
        "skipped",
        "manual"
      ],
      "properties": {
        "test": {
          "type": "string"
        },
        "run": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "written": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/written_mock"
          }
        },
        "kept": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kept_mock"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skipped_call"
          }
        },
        "manual": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/manual_call"
          }
        }
      }
    }
  }
}
