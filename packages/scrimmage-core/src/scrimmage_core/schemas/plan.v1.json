{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scrimmage:schema:plan:v1",
  "title": "Scrimmage plan, version 1",
  "description": "What the SDK does in one run. Data only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "run",
    "test",
    "row",
    "mocks",
    "faults",
    "tools",
    "real",
    "time_limit_s",
    "model_hosts",
    "budget"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "run": {
      "type": "string",
      "minLength": 1
    },
    "test": {
      "type": "string",
      "minLength": 1
    },
    "row": {
      "type": "string",
      "minLength": 1
    },
    "mocks": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "call",
              "returns"
            ],
            "properties": {
              "call": {
                "$ref": "#/$defs/tool_label"
              },
              "returns": {},
              "type": {
                "$ref": "#/$defs/import_path"
              },
              "recorded": {
                "type": "boolean"
              },
              "args": {
                "type": "object"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "call",
              "returns"
            ],
            "properties": {
              "call": {
                "$ref": "#/$defs/mcp_label"
              },
              "returns": {},
              "recorded": {
                "type": "boolean"
              },
              "args": {
                "type": "object"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "call",
              "status"
            ],
            "properties": {
              "call": {
                "$ref": "#/$defs/web_label"
              },
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "json": {},
              "text": {
                "type": "string"
              },
              "recorded": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "call",
          "do",
          "when"
        ],
        "properties": {
          "call": {
            "$ref": "#/$defs/call_label"
          },
          "do": {
            "type": "string",
            "pattern": "^(timeout|error|empty|status [45][0-9]{2})$"
          },
          "when": {
            "type": "string",
            "pattern": "^(always|(first|requests) [1-9][0-9]*)$"
          },
          "raises": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/import_path"
      }
    },
    "real": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/tool_label"
          },
          {
            "const": "tool:*"
          },
          {
            "const": "process:python"
          },
          {
            "$ref": "#/$defs/mcp_label"
          },
          {
            "type": "string",
            "pattern": "^hosted:mcp/[A-Za-z0-9_.-]+$"
          },
          {
            "type": "string",
            "pattern": "^http:(?:[a-f0-9:.]*:[a-f0-9:.]*|[a-z0-9][a-z0-9._-]*)( [A-Z]+( /[^\\s?#]*)?)?$"
          }
        ]
      }
    },
    "children": {
      "type": "boolean"
    },
    "time_limit_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "renames": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "model_hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host",
          "provider"
        ],
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "enum": [
              "openai"
            ]
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit_usd",
        "reserve_output_tokens",
        "prices"
      ],
      "properties": {
        "limit_usd": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "reserve_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "prices": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "output"
            ],
            "properties": {
              "input": {
                "type": "number",
                "minimum": 0
              },
              "output": {
                "type": "number",
                "minimum": 0
              },
              "cached_input": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "tool_label": {
      "type": "string",
      "pattern": "^tool:[A-Za-z0-9_-]+$"
    },
    "import_path": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "model_label": {
      "type": "string",
      "pattern": "^model(:(openai|\\*)(/(embeddings|moderations|input_tokens))?)?$"
    },
    "call_label": {
      "anyOf": [
        {
          "$ref": "#/$defs/tool_label"
        },
        {
          "$ref": "#/$defs/model_label"
        },
        {
          "$ref": "#/$defs/web_label"
        },
        {
          "$ref": "#/$defs/mcp_label"
        }
      ]
    },
    "mcp_label": {
      "type": "string",
      "pattern": "^mcp:[^*]+$"
    },
    "web_label": {
      "type": "string",
      "pattern": "^http:[a-f0-9:.]*:[a-f0-9:.]*$|^http:[a-z0-9][a-z0-9._-]*$"
    }
  }
}
