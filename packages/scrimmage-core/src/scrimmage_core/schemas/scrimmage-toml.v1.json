{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scrimmage:schema:scrimmage-toml:v1",
  "title": "scrimmage.toml, version 1",
  "description": "The shape of scrimmage.toml, for an editor: keys, types, label forms, schedules and fault words. It cannot check what needs the whole file, the folder or the machine, such as a tool name against [agent] tools. scrimmage check decides.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "test"
  ],
  "properties": {
    "agent": {
      "$ref": "#/$defs/agent"
    },
    "test": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/test"
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/value"
    }
  ],
  "$defs": {
    "text": {
      "$ref": "#/$defs/plain_text",
      "pattern": "\\S"
    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "import_path": {
      "type": "string",
      "pattern": "^[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)*:[A-Za-z_]\\w*$"
    },
    "tool_path": {
      "type": "string",
      "pattern": "^[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)*:[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)?$",
      "description": "package.module:function, or package.module:Class.method for a class at the module's top level."
    },
    "tool_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "whole": {
      "type": "integer",
      "minimum": 1
    },
    "tool_label": {
      "type": "string",
      "pattern": "^tool:[A-Za-z0-9_-]+$"
    },
    "mcp_label": {
      "type": "string",
      "pattern": "^mcp:[^\\s/*]([^*]*[^\\s/*])?$"
    },
    "web_label": {
      "type": "string",
      "pattern": "^http:([A-Za-z0-9][A-Za-z0-9._-]*|\\[?[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]*\\]?)$"
    },
    "model_label": {
      "type": "string",
      "pattern": "^model(:openai(/(embeddings|moderations|input_tokens))?|:\\*/(embeddings|moderations|input_tokens))?$"
    },
    "real_label": {
      "type": "string",
      "pattern": "^(tool:([A-Za-z0-9_-]+|\\*)|mcp:[^\\s/*]([^*]*[^\\s/*])?|hosted:mcp/[A-Za-z0-9_.-]+|process:python|http:([A-Za-z0-9][A-Za-z0-9._-]*|\\[?[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]*\\]?)( [A-Za-z][A-Za-z-]*( /[!\"$->@-~]*)?)?)$"
    },
    "method": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z-]*$"
    },
    "path": {
      "type": "string",
      "pattern": "^/[!\"$->@-~]*$",
      "description": "As a URL writes it: percent-encoded, with no query string."
    },
    "schedule": {
      "type": "string",
      "pattern": "^(always|first [1-9][0-9]*)$"
    },
    "expect": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/text"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        ]
      }
    },
    "pass_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "dollars": {
      "type": "number",
      "minimum": 0
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/dollars"
        },
        "output": {
          "$ref": "#/$defs/dollars"
        },
        "cached_input": {
          "$ref": "#/$defs/dollars"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "function"
          ]
        },
        {
          "required": [
            "command"
          ]
        }
      ],
      "dependentSchemas": {
        "answer": {
          "required": [
            "function"
          ]
        }
      },
      "properties": {
        "function": {
          "$ref": "#/$defs/import_path"
        },
        "command": {
          "type": "string",
          "pattern": "\\{question\\}",
          "description": "A script's command line. It must hold {question}."
        },
        "children": {
          "type": "boolean"
        },
        "runs": {
          "$ref": "#/$defs/whole"
        },
        "parallel": {
          "$ref": "#/$defs/whole"
        },
        "run_timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tools": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/tool_path"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "name"
                ],
                "properties": {
                  "path": {
                    "$ref": "#/$defs/tool_path"
                  },
                  "name": {
                    "$ref": "#/$defs/tool_name"
                  }
                }
              }
            ]
          }
        },
        "real": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/real_label"
          }
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "const": "none"
            }
          ]
        },
        "model_hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "provider"
            ],
            "properties": {
              "host": {
                "type": "string",
                "pattern": "^[^:/]*[^:/\\s][^:/]*$"
              },
              "provider": {
                "enum": [
                  "openai"
                ]
              }
            }
          }
        },
        "reserve_output_tokens": {
          "$ref": "#/$defs/whole"
        },
        "prices": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/price"
          }
        },
        "answer": {
          "type": "string",
          "pattern": "^[A-Za-z_]\\w*(\\[-?\\d+\\]|\\.[A-Za-z_]\\w*)*$"
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "question",
        "expect"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "question": {
          "$ref": "#/$defs/text"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "forbid": {
          "$ref": "#/$defs/texts"
        },
        "pass_rate": {
          "$ref": "#/$defs/pass_rate"
        },
        "mock": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mock"
          }
        },
        "fault": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fault"
          }
        }
      }
    },
    "mock": {
      "type": "object",
      "required": [
        "call"
      ],
      "properties": {
        "call": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "call": {
            "pattern": "^http:"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/web_mock"
      },
      "else": {
        "if": {
          "properties": {
            "call": {
              "pattern": "^mcp:"
            }
          }
        },
        "then": {
          "$ref": "#/$defs/mcp_mock"
        },
        "else": {
          "$ref": "#/$defs/tool_mock"
        }
      }
    },
    "tool_mock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call",
        "returns"
      ],
      "properties": {
        "call": {
          "$ref": "#/$defs/tool_label"
        },
        "returns": {},
        "type": {
          "$ref": "#/$defs/import_path"
        },
        "recorded": {
          "type": "boolean"
        },
        "args": {
          "type": "object"
        }
      },
      "dependentSchemas": {
        "args": {
          "required": [
            "recorded"
          ],
          "properties": {
            "recorded": {
              "const": true
            }
          }
        }
      }
    },
    "mcp_mock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call",
        "returns"
      ],
      "properties": {
        "call": {
          "$ref": "#/$defs/mcp_label"
        },
        "returns": {},
        "recorded": {
          "type": "boolean"
        },
        "args": {
          "type": "object"
        }
      },
      "dependentSchemas": {
        "args": {
          "required": [
            "recorded"
          ],
          "properties": {
            "recorded": {
              "const": true
            }
          }
        }
      }
    },
    "web_mock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call"
      ],
      "not": {
        "required": [
          "json",
          "text"
        ]
      },
      "properties": {
        "call": {
          "$ref": "#/$defs/web_label"
        },
        "method": {
          "$ref": "#/$defs/method"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "json": {},
        "text": {
          "$ref": "#/$defs/text"
        },
        "recorded": {
          "type": "boolean"
        }
      }
    },
    "fault": {
      "type": "object",
      "required": [
        "call",
        "do"
      ],
      "properties": {
        "call": {
          "type": "string"
        }
      },
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "when"
              ]
            }
          },
          {
            "properties": {
              "when": {
                "const": "always"
              }
            }
          }
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "expect"
            ]
          },
          {
            "required": [
              "forbid"
            ],
            "properties": {
              "forbid": {
                "minItems": 1
              }
            }
          }
        ],
        "description": "A fault that fires on every call needs its own expect or forbid."
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "call": {
                "pattern": "^http:"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/web_fault"
          }
        },
        {
          "if": {
            "properties": {
              "call": {
                "pattern": "^mcp:"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/mcp_fault"
          }
        },
        {
          "if": {
            "properties": {
              "call": {
                "pattern": "^model(:|$)"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/model_fault"
          }
        },
        {
          "if": {
            "properties": {
              "call": {
                "pattern": "^(http|mcp|model):|^model$"
              }
            }
          },
          "else": {
            "$ref": "#/$defs/tool_fault"
          }
        }
      ]
    },
    "tool_fault": {
      "type": "object",
      "additionalProperties": false,
      "dependentSchemas": {
        "raises": {
          "properties": {
            "do": {
              "const": "error"
            }
          }
        }
      },
      "properties": {
        "call": {
          "$ref": "#/$defs/tool_label"
        },
        "do": {
          "enum": [
            "timeout",
            "error"
          ]
        },
        "when": {
          "$ref": "#/$defs/schedule"
        },
        "raises": {
          "type": "string",
          "pattern": "^[A-Za-z_]\\w*((\\.[A-Za-z_]\\w*)*:[A-Za-z_]\\w*)?$",
          "description": "A built-in exception, or package.module:Class."
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "forbid": {
          "$ref": "#/$defs/texts"
        },
        "pass_rate": {
          "$ref": "#/$defs/pass_rate"
        }
      }
    },
    "model_fault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call": {
          "$ref": "#/$defs/model_label"
        },
        "do": {
          "type": "string",
          "pattern": "^(timeout|status [45][0-9][0-9])$"
        },
        "when": {
          "type": "string",
          "pattern": "^(always|(first|requests) [1-9][0-9]*)$"
        },
        "raises": {
          "not": {},
          "description": "raises works only with do = \"error\", which a model call does not take."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s*]([^*]*[^\\s*])?$"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "forbid": {
          "$ref": "#/$defs/texts"
        },
        "pass_rate": {
          "$ref": "#/$defs/pass_rate"
        }
      }
    },
    "web_fault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call": {
          "$ref": "#/$defs/web_label"
        },
        "do": {
          "type": "string",
          "pattern": "^(timeout|status [45][0-9][0-9])$"
        },
        "when": {
          "$ref": "#/$defs/schedule"
        },
        "method": {
          "$ref": "#/$defs/method"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "forbid": {
          "$ref": "#/$defs/texts"
        },
        "pass_rate": {
          "$ref": "#/$defs/pass_rate"
        }
      }
    },
    "mcp_fault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call": {
          "$ref": "#/$defs/mcp_label"
        },
        "do": {
          "enum": [
            "timeout",
            "error",
            "empty"
          ]
        },
        "when": {
          "$ref": "#/$defs/schedule"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "forbid": {
          "$ref": "#/$defs/texts"
        },
        "pass_rate": {
          "$ref": "#/$defs/pass_rate"
        }
      }
    },
    "plain_text": {
      "type": "string",
      "not": {
        "pattern": "\\$\\{"
      },
      "description": "Text with no ${, as ${...} placeholders are not read in this version."
    },
    "value": {
      "description": "Any value the file holds, at any depth, with no ${ in its text.",
      "anyOf": [
        {
          "$ref": "#/$defs/plain_text"
        },
        {
          "type": [
            "number",
            "boolean"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    }
  }
}
