{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scrimmage:schema:scrimmage-toml:v1",
  "title": "scrimmage.toml, version 1",
  "description": "The shape of scrimmage.toml, for an editor: keys, types, label forms, schedules and fault words. It cannot check what needs the whole file, the folder or the machine, such as a tool name against [agent] tools. scrimmage check decides.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "test"
  ],
  "properties": {
    "agent": {
      "$ref": "#/$defs/agent"
    },
    "test": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/test"
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/value"
    }
  ],
  "$defs": {
    "text": {
      "$ref": "#/$defs/plain_text",
      "pattern": "\\S"
    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "import_path": {
      "type": "string",
      "pattern": "^[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)*:[A-Za-z_]\\w*$"
    },
    "tool_path": {
      "type": "string",
      "pattern": "^[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)*:[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)?$",
      "description": "package.module:function, or package.module:Class.method for a class at the module's top level."
    },
    "tool_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "whole": {
      "type": "integer",
      "minimum": 1
    },
    "tool_label": {
      "type": "string",
      "pattern": "^tool:[A-Za-z0-9_-]+$"
    },
    "mcp_label": {
      "type": "string",
      "pattern": "^mcp:[^\\s/*]([^*]*[^\\s/*])?$"
    },
    "web_label": {
      "type": "string",
      "pattern": "^http:([A-Za-z0-9][A-Za-z0-9._-]*|\\[?[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]*\\]?)$"
    },
    "model_label": {
      "type": "string",
      "pattern": "^model(:openai(/(embeddings|moderations|input_tokens))?|:\\*/(embeddings|moderations|input_tokens))?$"
    },
    "real_label": {
      "type": "string",
      "pattern": "^(tool:([A-Za-z0-9_-]+|\\*)|mcp:[^\\s/*]([^*]*[^\\s/*])?|hosted:mcp/[A-Za-z0-9_.-]+|process:[A-Za-z0-9_][A-Za-z0-9._+-]*|http:([A-Za-z0-9][A-Za-z0-9._-]*|\\[?[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]*\\]?)( [A-Za-z][A-Za-z-]*( /[!\"$->@-~]*)?)?)$"
    },
    "method": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z-]*$"
    },
    "path": {
      "type": "string",
      "pattern": "^/[!\"$->@-~]*$",
      "description": "As a URL writes it: percent-encoded, with no query string."
    },
    "schedule": {
      "type": "string",
      "pattern": "^(always|(first|call) [1-9][0-9]*)$"
    },
    "expect": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/text"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        ]
      }
    },
    "pass_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "dollars": {
      "type": "number",
      "minimum": 0
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/dollars"
        },
        "output": {
          "$ref": "#/$defs/dollars"
        },
        "cached_input": {
          "$ref": "#/$defs/dollars"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "function"
          ]
        },
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "service"
          ]
        }
      ],
      "dependentSchemas": {
        "answer": {
          "anyOf": [
            {
              "required": [
                "function"
              ]
            },
            {
              "required": [
                "service"
              ]
            }
          ]
        },
        "body": {
          "required": [
            "service"
          ]
        },
        "headers": {
          "required": [
            "service"
          ]
        },
        "record_grace_s": {
          "required": [
            "service"
          ]
        },
        "record_wait_s": {
          "required": [
            "service"
          ]
        },
        "background_real": {
          "required": [
            "service"
          ]
        },
        "control": {
          "required": [
            "service"
          ]
        },
        "control_tls": {
          "required": [
            "service",
            "control"
          ]
        },
        "service": {
          "required": [
            "body"
          ],
          "not": {
            "required": [
              "children"
            ]
          }
        },
        "start": {
          "required": [
            "service"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "control"
                ]
              },
              {
                "required": [
                  "control_tls"
                ]
              }
            ]
          },
          "properties": {
            "service": {
              "pattern": "^http://(127\\.0\\.0\\.1|\\[::1\\]|[Ll][Oo][Cc][Aa][Ll][Hh][Oo][Ss][Tt]):\\{port\\}(/[^#\\s]*)?$"
            }
          }
        }
      },
      "properties": {
        "function": {
          "$ref": "#/$defs/import_path"
        },
        "command": {
          "type": "string",
          "pattern": "\\{question\\}",
          "description": "A script's command line. It must hold {question}."
        },
        "children": {
          "type": "boolean"
        },
        "runs": {
          "$ref": "#/$defs/whole"
        },
        "parallel": {
          "$ref": "#/$defs/whole"
        },
        "run_timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tools": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/tool_path"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "name"
                ],
                "properties": {
                  "path": {
                    "$ref": "#/$defs/tool_path"
                  },
                  "name": {
                    "$ref": "#/$defs/tool_name"
                  }
                }
              }
            ]
          }
        },
        "real": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/real_label"
          }
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "const": "none"
            }
          ]
        },
        "model_hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "provider"
            ],
            "properties": {
              "host": {
                "type": "string",
                "pattern": "^[^:/]*[^:/\\s][^:/]*$"
              },
              "provider": {
                "enum": [
                  "openai"
                ]
              }
            }
          }
        },
        "reserve_output_tokens": {
          "$ref": "#/$defs/whole"
        },
        "prices": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/price"
          }
        },
        "answer": {
          "type": "string",
          "pattern": "^[A-Za-z_]\\w*(\\[-?\\d+\\]|\\.[A-Za-z_]\\w*)*$"
        },
        "service": {
          "type": "string",
          "pattern": "^http://[^/?#\\s]+(/[^#\\s]*)?$",
          "description": "An agent inside a web service: http://host:port/path, sent one POST per run. https is not read in this version."
        },
        "body": {
          "type": [
            "string",
            "object",
            "array"
          ],
          "description": "A service run's body, sent as JSON. It must hold {question} in a text value; {session} is new for every run, and {{ and }} are a brace."
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$",
            "not": {
              "pattern": "^([Xx]-[Ss][Cc][Rr][Ii][Mm][Mm][Aa][Gg][Ee]-.*|[Hh][Oo][Ss][Tt]|[Cc][Oo][Nn][Tt][Ee][Nn][Tt]-[Ll][Ee][Nn][Gg][Tt][Hh]|[Cc][Oo][Nn][Tt][Ee][Nn][Tt]-[Tt][Yy][Pp][Ee]|[Tt][Rr][Aa][Nn][Ss][Ff][Ee][Rr]-[Ee][Nn][Cc][Oo][Dd][Ii][Nn][Gg]|[Cc][Oo][Nn][Nn][Ee][Cc][Tt][Ii][Oo][Nn])$"
            }
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "A service run's headers. A value may hold ${NAME} and {session}, never {question}. Scrimmage sets x-scrimmage-*, Host, Content-Length, Content-Type, Transfer-Encoding and Connection itself."
        },
        "record_grace_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "description": "How long a service run's record stays open after its reply. Default 5."
        },
        "record_wait_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120,
          "description": "How much longer the runner waits for a service run's last lines. Default 10."
        },
        "background_real": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/real_label"
          },
          "description": "Calls that work outside any request, such as a telemetry exporter, may make for real while a test runs. Never read for a call inside a run."
        },
        "control": {
          "type": "string",
          "description": "The ip:port the runner listens on for a service in a container, such as 172.17.0.1:8766. An IP address, never a name, and never every address. Any address but loopback needs control_tls."
        },
        "control_tls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cert",
            "key"
          ],
          "properties": {
            "cert": {
              "type": "string",
              "minLength": 1,
              "description": "The certificate chain, a PEM file, as a path from the folder of this file."
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "description": "Its private key, a PEM file you own, mode 600."
            }
          },
          "description": "The certificate and key the control server speaks TLS with. Needs control. scrimmage cert makes them."
        },
        "start": {
          "type": "string",
          "pattern": "\\{port\\}",
          "description": "The command that starts a test copy of the service, such as uvicorn shop.service:app --port {port}. It must hold {port}, and service must then hold {port} as its port on 127.0.0.1, [::1] or localhost. Not with control or control_tls."
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "question",
        "expect"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "question": {
          "$ref": "#/$defs/text"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "forbid": {
          "$ref": "#/$defs/texts"
        },
        "pass_rate": {
          "$ref": "#/$defs/pass_rate"
        },
        "mock": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mock"
          }
        },
        "fault": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fault"
          }
        }
      }
    },
    "mock": {
      "type": "object",
      "required": [
        "call"
      ],
      "properties": {
        "call": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "call": {
            "pattern": "^http:"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/web_mock"
      },
      "else": {
        "if": {
          "properties": {
            "call": {
              "pattern": "^mcp:"
            }
          }
        },
        "then": {
          "$ref": "#/$defs/mcp_mock"
        },
        "else": {
          "$ref": "#/$defs/tool_mock"
        }
      }
    },
    "tool_mock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call",
        "returns"
      ],
      "properties": {
        "call": {
          "$ref": "#/$defs/tool_label"
        },
        "returns": {},
        "type": {
          "$ref": "#/$defs/import_path"
        },
        "recorded": {
          "type": "boolean"
        },
        "args": {
          "type": "object"
        }
      }
    },
    "mcp_mock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call",
        "returns"
      ],
      "properties": {
        "call": {
          "$ref": "#/$defs/mcp_label"
        },
        "returns": {},
        "recorded": {
          "type": "boolean"
        },
        "args": {
          "type": "object"
        }
      }
    },
    "web_mock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call"
      ],
      "not": {
        "required": [
          "json",
          "text"
        ]
      },
      "properties": {
        "call": {
          "$ref": "#/$defs/web_label"
        },
        "method": {
          "$ref": "#/$defs/method"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "json": {},
        "text": {
          "$ref": "#/$defs/text"
        },
        "recorded": {
          "type": "boolean"
        }
      }
    },
    "fault": {
      "type": "object",
      "required": [
        "call",
        "do"
      ],
      "properties": {
        "call": {
          "type": "string"
        }
      },
      "if": {
        "allOf": [
          {
            "anyOf": [
              {
                "not": {
                  "required": [
                    "when"
                  ]
                }
              },
              {
                "properties": {
                  "when": {
                    "const": "always"
                  }
                }
              }
            ]
          },
          {
            "not": {
              "required": [
                "do"
              ],
              "properties": {
                "do": {
                  "const": "append"
                }
              }
            }
          },
          {
            "not": {
              "required": [
                "do",
                "find"
              ],
              "properties": {
                "do": {
                  "const": "replace"
                }
              }
            }
          }
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "expect"
            ]
          },
          {
            "required": [
              "forbid"
            ],
            "properties": {
              "forbid": {
                "minItems": 1
              }
            }
          }
        ],
        "description": "A fault that fires on every call needs its own expect or forbid."
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "call": {
                "pattern": "^http:"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/web_fault"
          }
        },
        {
          "if": {
            "properties": {
              "call": {
                "pattern": "^mcp:"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/mcp_fault"
          }
        },
        {
          "if": {
            "properties": {
              "call": {
                "pattern": "^model(:|$)"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/model_fault"
          }
        },
        {
          "if": {
            "properties": {
              "call": {
                "pattern": "^(http|mcp|model):|^model$"
              }
            }
          },
          "else": {
            "$ref": "#/$defs/tool_fault"
          }
        },
        {
          "$ref": "#/$defs/change_rules"
        }
      ]
    },
    "tool_fault": {
      "type": "object",
      "additionalProperties": false,
      "dependentSchemas": {
        "raises": {
          "properties": {
            "do": {
              "const": "error"
            }
          }
        }
      },
      "properties": {
        "call": {
          "$ref": "#/$defs/tool_label"
        },
        "do": {
          "anyOf": [
            {
              "enum": [
                "timeout",
                "error",
                "empty",
                "append",
                "replace"
              ]
            },
            {
              "$ref": "#/$defs/slow"
            }
          ]
        },
        "when": {
          "$ref": "#/$defs/schedule"
        },
        "raises": {
          "type": "string",
          "pattern": "^[A-Za-z_]\\w*((\\.[A-Za-z_]\\w*)*:[A-Za-z_]\\w*)?$",
          "description": "A built-in exception, or package.module:Class."
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "forbid": {
          "$ref": "#/$defs/texts"
        },
        "pass_rate": {
          "$ref": "#/$defs/pass_rate"
        },
        "text": {
          "$ref": "#/$defs/change_text"
        },
        "find": {
          "$ref": "#/$defs/change_find"
        }
      }
    },
    "model_fault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call": {
          "$ref": "#/$defs/model_label"
        },
        "do": {
          "type": "string",
          "pattern": "^(timeout|refused|reset|dns|bad body|replace|slow [0-9]+(\\.[0-9]+)?s|status [45][0-9][0-9])$"
        },
        "when": {
          "type": "string",
          "pattern": "^(always|(first|requests|call) [1-9][0-9]*)$"
        },
        "raises": {
          "not": {},
          "description": "raises works only with do = \"error\", which a model call does not take."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s*]([^*]*[^\\s*])?$"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "forbid": {
          "$ref": "#/$defs/texts"
        },
        "pass_rate": {
          "$ref": "#/$defs/pass_rate"
        },
        "text": {
          "$ref": "#/$defs/change_text"
        },
        "find": {
          "$ref": "#/$defs/change_find"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "do"
            ],
            "properties": {
              "do": {
                "const": "replace"
              }
            }
          },
          "then": {
            "required": [
              "model"
            ]
          },
          "description": "replace on a model call needs the model's name."
        },
        {
          "if": {
            "required": [
              "call"
            ],
            "properties": {
              "call": {
                "pattern": "/"
              }
            }
          },
          "then": {
            "properties": {
              "do": {
                "pattern": "^(timeout|refused|reset|dns|bad body|status [45][0-9][0-9])$"
              }
            }
          },
          "description": "replace and slow work on a chat call, not on a call that only reads."
        }
      ]
    },
    "web_fault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call": {
          "$ref": "#/$defs/web_label"
        },
        "do": {
          "type": "string",
          "pattern": "^(timeout|refused|reset|dns|empty|bad body|append|replace|slow [0-9]+(\\.[0-9]+)?s|status [45][0-9][0-9])$"
        },
        "when": {
          "$ref": "#/$defs/schedule"
        },
        "method": {
          "$ref": "#/$defs/method"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "forbid": {
          "$ref": "#/$defs/texts"
        },
        "pass_rate": {
          "$ref": "#/$defs/pass_rate"
        },
        "text": {
          "$ref": "#/$defs/change_text"
        },
        "find": {
          "$ref": "#/$defs/change_find"
        }
      }
    },
    "mcp_fault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call": {
          "$ref": "#/$defs/mcp_label"
        },
        "do": {
          "anyOf": [
            {
              "enum": [
                "timeout",
                "error",
                "empty",
                "append",
                "replace"
              ]
            },
            {
              "$ref": "#/$defs/slow"
            }
          ]
        },
        "when": {
          "$ref": "#/$defs/schedule"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "forbid": {
          "$ref": "#/$defs/texts"
        },
        "pass_rate": {
          "$ref": "#/$defs/pass_rate"
        },
        "text": {
          "$ref": "#/$defs/change_text"
        },
        "find": {
          "$ref": "#/$defs/change_find"
        }
      }
    },
    "plain_text": {
      "type": "string",
      "description": "Text. ${NAME} is read from the environment when the file is read, and $${ is a literal ${."
    },
    "value": {
      "description": "Any value the file holds, at any depth.",
      "anyOf": [
        {
          "$ref": "#/$defs/plain_text"
        },
        {
          "type": [
            "number",
            "boolean"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    },
    "slow": {
      "type": "string",
      "pattern": "^slow [0-9]+(\\.[0-9]+)?s$"
    },
    "change_text": {
      "type": "string",
      "maxLength": 65536,
      "description": "Text. At most 64 KiB."
    },
    "change_find": {
      "$ref": "#/$defs/change_text",
      "pattern": "\\S"
    },
    "change_rules": {
      "description": "text goes with append and replace, and find with replace.",
      "allOf": [
        {
          "if": {
            "required": [
              "do"
            ],
            "properties": {
              "do": {
                "enum": [
                  "append",
                  "replace"
                ]
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "dependentSchemas": {
            "text": {
              "required": [
                "do"
              ],
              "properties": {
                "do": {
                  "enum": [
                    "append",
                    "replace"
                  ]
                }
              }
            },
            "find": {
              "required": [
                "do"
              ],
              "properties": {
                "do": {
                  "const": "replace"
                }
              }
            }
          }
        }
      ]
    }
  }
}
