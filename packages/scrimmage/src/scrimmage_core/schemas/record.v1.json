{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scrimmage:schema:record:v1",
  "title": "Scrimmage record line, version 1",
  "description": "One line of a run's JSON Lines record: a call, or the summary that ends the record.",
  "oneOf": [
    {
      "$ref": "#/$defs/call"
    },
    {
      "$ref": "#/$defs/summary"
    },
    {
      "$ref": "#/$defs/notice"
    }
  ],
  "$defs": {
    "head": {
      "type": "object",
      "required": [
        "v",
        "run",
        "test",
        "row"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "run": {
          "type": "string",
          "minLength": 1
        },
        "test": {
          "type": "string",
          "minLength": 1
        },
        "row": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes",
        "preview"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "preview": {
          "type": "string",
          "maxLength": 200
        },
        "cut": {
          "const": true
        },
        "unsaved": {
          "const": true
        }
      }
    },
    "call": {
      "allOf": [
        {
          "$ref": "#/$defs/head"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "seq",
        "proc",
        "call",
        "kind",
        "action",
        "args",
        "result",
        "error",
        "start",
        "ms"
      ],
      "properties": {
        "v": true,
        "run": true,
        "test": true,
        "row": true,
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "proc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "pid",
            "started"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "pid": {
              "type": "integer"
            },
            "started": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "call": {
          "type": "string",
          "pattern": "^(tool:[A-Za-z0-9_-]+|model:[a-z*]+(/[a-z_]+)?|http:.+|mcp:.+|process:(?:[A-Za-z0-9_][A-Za-z0-9._+-]*|\\?)(?![\\s\\S]))$"
        },
        "kind": {
          "enum": [
            "tool",
            "model",
            "http",
            "mcp",
            "process"
          ]
        },
        "action": {
          "enum": [
            "real",
            "mock",
            "fault",
            "refused"
          ]
        },
        "fault": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "do",
            "when",
            "n"
          ],
          "properties": {
            "do": {
              "type": "string",
              "pattern": "^(timeout|error|empty|bad body|context too long|garble|truncate|unknown tool|bad tool args|refuse|append|replace|refused|reset|dns|slow [0-9]+(\\.[0-9]+)?s|status [45][0-9]{2})$"
            },
            "when": {
              "type": "string",
              "pattern": "^(always|(first|requests|call) [1-9][0-9]*)$"
            },
            "n": {
              "type": "integer",
              "minimum": 1
            },
            "retry_after": {
              "type": "integer",
              "minimum": 0,
              "description": "The Retry-After header a status 429 or 503 fault sent, in seconds."
            }
          }
        },
        "args": {
          "$ref": "#/$defs/content"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/content"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "mistake": {
          "type": "string"
        },
        "by_config": {
          "const": true,
          "description": "On a refused call: the test's own setup caused the refusal, not a choice of the agent."
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "ms": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "enum": [
            "unlisted",
            "poisoned",
            "budget",
            "budget_held",
            "no_price",
            "hosted",
            "unknown_tool_type",
            "unseen_tool",
            "web_write",
            "control_unreachable",
            "unreadable_body",
            "unreadable_model",
            "redirect_off_host",
            "unsupported_loop",
            "ambiguous_label",
            "blind_child",
            "service_child",
            "no_plan",
            "probe",
            "mistake"
          ]
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "retry": {
          "type": "integer",
          "minimum": 0
        },
        "forwarded_to": {
          "type": "string"
        },
        "mock": {
          "type": "integer",
          "minimum": 0
        },
        "stream": {
          "type": "boolean"
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "output",
            "cached"
          ],
          "properties": {
            "input": {
              "type": "integer",
              "minimum": 0
            },
            "output": {
              "type": "integer",
              "minimum": 0
            },
            "cached": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_estimated": {
          "type": "boolean"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "usd",
            "spent",
            "held",
            "limit",
            "waited_s"
          ],
          "properties": {
            "usd": {
              "type": "number",
              "minimum": 0
            },
            "spent": {
              "type": "number",
              "minimum": 0
            },
            "held": {
              "type": "number",
              "minimum": 0
            },
            "limit": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "waited_s": {
              "type": "number",
              "minimum": 0
            },
            "holds": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "run",
                  "label",
                  "usd",
                  "ended"
                ],
                "properties": {
                  "run": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "usd": {
                    "type": "number",
                    "minimum": 0
                  },
                  "ended": {
                    "type": "boolean"
                  }
                }
              }
            },
            "own": {
              "type": "boolean"
            }
          }
        },
        "reply_incomplete": {
          "const": true
        },
        "unseen_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hosted_reads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "call_id": {
          "type": "integer",
          "minimum": 1
        },
        "parent": {
          "type": "integer",
          "minimum": 1
        },
        "recorded": {
          "$ref": "#/$defs/recorded"
        },
        "args_not_plain": {
          "const": true
        },
        "mock_miss": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "seen",
            "method",
            "path",
            "nearest"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "seen": {
              "type": [
                "string",
                "null"
              ]
            },
            "method": {
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "nearest": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mock",
                    "args",
                    "method",
                    "path",
                    "differs",
                    "differs_left_out"
                  ],
                  "properties": {
                    "mock": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "args": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "method": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "path": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "differs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "differs_left_out": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              ]
            }
          }
        },
        "under": {
          "enum": [
            "real",
            "mock"
          ],
          "description": "A carried fault (append, replace, slow): what the call got beneath it."
        },
        "changed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "parts"
          ],
          "properties": {
            "text": {
              "$ref": "#/$defs/content",
              "description": "The fault's own text, never redacted. A fault in a model's reply has none."
            },
            "reply": {
              "$ref": "#/$defs/content",
              "description": "The reply the agent got in place of the real one, which stays the line's result."
            },
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599,
              "description": "The status the agent got, when it is not the real reply's: truncate on a reply with only tool calls."
            },
            "find": {
              "$ref": "#/$defs/content",
              "description": "The find text: its preview is redacted, its sha256 is of the raw text."
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "parts": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "unchanged": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "do",
            "why"
          ],
          "properties": {
            "do": {
              "type": "string"
            },
            "why": {
              "type": "string"
            }
          }
        },
        "slowed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cut_by": {
          "enum": [
            "client timeout",
            "run stopped",
            "time limit",
            "cancelled"
          ]
        },
        "carries_injected": {
          "const": true,
          "description": "A model request that holds the text a fault put in a result (a heuristic)."
        },
        "after_reply_fault": {
          "const": true,
          "description": "A model's real 400 to a chat request that, as sent, held what a fault in a model's reply gave the agent: the agent's result, not an infrastructure error."
        }
      }
    },
    "summary": {
      "allOf": [
        {
          "$ref": "#/$defs/head"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "v": true,
        "run": true,
        "test": true,
        "row": true,
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answer",
            "outcome",
            "fault_fired",
            "calls",
            "incomplete",
            "model_calls",
            "cost_usd",
            "judged",
            "broken_rules",
            "left_out"
          ],
          "properties": {
            "answer": {
              "type": [
                "string",
                "null"
              ]
            },
            "outcome": {
              "enum": [
                "answered",
                "crashed",
                "timed out",
                "refused call",
                "budget reached",
                "not reserved",
                "infrastructure error",
                "stopped"
              ]
            },
            "fault_fired": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "calls": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "real",
                "mock",
                "fault",
                "refused",
                "under_real"
              ],
              "properties": {
                "real": {
                  "type": "integer",
                  "minimum": 0
                },
                "mock": {
                  "type": "integer",
                  "minimum": 0
                },
                "fault": {
                  "type": "integer",
                  "minimum": 0
                },
                "refused": {
                  "type": "integer",
                  "minimum": 0
                },
                "under_real": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "incomplete": {
              "type": "boolean"
            },
            "model_calls": {
              "type": "integer",
              "minimum": 0
            },
            "cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "judged": {
              "enum": [
                "pass",
                "fail",
                "left out"
              ]
            },
            "broken_rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "text"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "expect",
                      "forbid",
                      "empty",
                      "crashed",
                      "timed out",
                      "refused"
                    ]
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            },
            "left_out": {
              "type": [
                "string",
                "null"
              ]
            },
            "control_busy": {
              "type": "integer",
              "minimum": 0,
              "description": "From the run's last batch: control requests the process refused itself, for no free slot, from the run's start or claim to its close."
            },
            "control_p99_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "From the run's last batch: the 99th percentile control round trip in that window, in milliseconds."
            },
            "plan_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "In a service run: HMAC-SHA256, keyed by the run token, of the runner's own plan without elapsed_s and scrub. Without the token it tells a reader nothing about the plan."
            },
            "claimed_plan_digest": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$",
              "description": "In a service run: the same digest, taken by the claiming process over the plan its run state held when it sent its last batch. null when that batch never came."
            },
            "claimed_by": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "host",
                "pid"
              ],
              "description": "In a service run: the process that claimed the run. In a pod, host is the pod's name.",
              "properties": {
                "host": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pid": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "notice": {
      "allOf": [
        {
          "$ref": "#/$defs/head"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "seq",
        "proc",
        "notice",
        "library",
        "message"
      ],
      "properties": {
        "v": true,
        "run": true,
        "test": true,
        "row": true,
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "proc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "pid",
            "started"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "pid": {
              "type": "integer"
            },
            "started": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "notice": {
          "enum": [
            "structure",
            "newer_version",
            "tools_seen",
            "answer_path",
            "process",
            "other_python",
            "left_group",
            "probe",
            "model_path",
            "plan_changed",
            "mock_type"
          ]
        },
        "mock": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "boolean"
        },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "python",
            "command",
            "parent"
          ],
          "properties": {
            "python": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "parent": {
              "type": "integer"
            }
          }
        },
        "library": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "mistake": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "paths",
                  "adapter"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "adapter": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        },
        "model_request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "method",
            "path",
            "provider"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          }
        },
        "stopped_at": {
          "type": "string"
        },
        "unreadable": {
          "type": "boolean"
        }
      }
    },
    "recorded": {
      "oneOf": [
        {
          "description": "A real tool or MCP call's value and arguments, cleaned.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "args",
            "removed"
          ],
          "properties": {
            "value": {
              "$ref": "#/$defs/content"
            },
            "args": {
              "$ref": "#/$defs/content"
            },
            "type": {
              "type": "string",
              "pattern": "^[A-Za-z_][\\w.]*:[A-Za-z_]\\w*$"
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "rule"
                ],
                "properties": {
                  "key": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "rule": {
                    "enum": [
                      "pattern",
                      "key_name"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "description": "A real web request: the body is the line's result.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content_type",
            "utf8",
            "query_sha256",
            "path_changed",
            "removed"
          ],
          "properties": {
            "content_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "utf8": {
              "type": "boolean"
            },
            "query_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "path_changed": {
              "type": "boolean"
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "rule"
                ],
                "properties": {
                  "key": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "rule": {
                    "enum": [
                      "pattern",
                      "key_name"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "description": "Why no mock can be written from this call.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "why"
          ],
          "properties": {
            "code": {
              "enum": [
                "unsavable",
                "secret_changed_shape",
                "status",
                "credential",
                "scrimmage_error"
              ]
            },
            "why": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
