{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scrimmage:schema:plan:v1",
  "title": "Scrimmage plan, version 1",
  "description": "What the SDK does in one run. Data only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "run",
    "test",
    "row",
    "mocks",
    "faults",
    "tools",
    "real",
    "time_limit_s",
    "model_hosts",
    "budget"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "run": {
      "type": "string",
      "minLength": 1
    },
    "test": {
      "type": "string",
      "minLength": 1
    },
    "row": {
      "type": "string",
      "minLength": 1
    },
    "mocks": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "call",
              "returns_from"
            ],
            "properties": {
              "call": {
                "$ref": "#/$defs/tool_label"
              },
              "returns_from": {
                "$ref": "#/$defs/import_path"
              },
              "recorded": {
                "type": "boolean"
              },
              "args": {
                "type": "object"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "call",
              "returns"
            ],
            "properties": {
              "call": {
                "$ref": "#/$defs/tool_label"
              },
              "returns": {},
              "type": {
                "$ref": "#/$defs/import_path"
              },
              "recorded": {
                "type": "boolean"
              },
              "args": {
                "type": "object"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "call",
              "returns"
            ],
            "properties": {
              "call": {
                "$ref": "#/$defs/mcp_label"
              },
              "returns": {},
              "recorded": {
                "type": "boolean"
              },
              "args": {
                "type": "object"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "call",
              "status"
            ],
            "properties": {
              "call": {
                "$ref": "#/$defs/web_label"
              },
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "json": {},
              "text": {
                "type": "string"
              },
              "recorded": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "call",
          "do",
          "when"
        ],
        "properties": {
          "call": {
            "$ref": "#/$defs/call_label"
          },
          "do": {
            "type": "string",
            "pattern": "^(timeout|error|empty|bad body|context too long|garble|truncate|unknown tool|bad tool args|refuse|append|replace|refused|reset|dns|slow [0-9]+(\\.[0-9]+)?s|status [45][0-9]{2})$"
          },
          "when": {
            "type": "string",
            "pattern": "^(always|(first|requests|call) [1-9][0-9]*)$"
          },
          "raises": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "find": {
            "type": "string"
          },
          "retry_after": {
            "type": "integer",
            "minimum": 0
          },
          "form": {
            "enum": [
              "plain",
              "classifier"
            ]
          },
          "tool": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          }
        },
        "dependentSchemas": {
          "retry_after": {
            "properties": {
              "do": {
                "enum": [
                  "status 429",
                  "status 503"
                ]
              }
            }
          },
          "form": {
            "properties": {
              "do": {
                "const": "refuse"
              }
            }
          },
          "tool": {
            "properties": {
              "do": {
                "const": "unknown tool"
              }
            }
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/import_path"
      }
    },
    "real": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/tool_label"
          },
          {
            "const": "tool:*"
          },
          {
            "type": "string",
            "pattern": "^process:[A-Za-z0-9_][A-Za-z0-9._+-]*(?![\\s\\S])$"
          },
          {
            "$ref": "#/$defs/mcp_label"
          },
          {
            "type": "string",
            "pattern": "^hosted:mcp/[A-Za-z0-9_.-]+$"
          },
          {
            "type": "string",
            "pattern": "^http:(?:[a-f0-9:.]*:[a-f0-9:.]*|[a-z0-9][a-z0-9._-]*)( [A-Z]+( /[^\\s?#]*)?)?$"
          }
        ]
      }
    },
    "children": {
      "type": "boolean"
    },
    "time_limit_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "elapsed_s": {
      "description": "How long the run had been going when the runner sent this plan, in seconds. The SDK counts time_limit_s from the runner's start, not its own.",
      "type": "number",
      "minimum": 0
    },
    "renames": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "model_hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host",
          "provider"
        ],
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "enum": [
              "openai",
              "anthropic"
            ]
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit_usd",
        "reserve_output_tokens",
        "prices"
      ],
      "properties": {
        "limit_usd": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "reserve_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "prices": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "output"
            ],
            "properties": {
              "input": {
                "type": "number",
                "minimum": 0
              },
              "output": {
                "type": "number",
                "minimum": 0
              },
              "cached_input": {
                "type": "number",
                "minimum": 0
              },
              "cache_write_30m": {
                "type": "number",
                "minimum": 0
              },
              "cache_write_12h": {
                "type": "number",
                "minimum": 0
              },
              "web_search_request": {
                "type": "number",
                "minimum": 0
              },
              "cache_write_5m": {
                "type": "number",
                "minimum": 0
              },
              "cache_write_1h": {
                "type": "number",
                "minimum": 0
              },
              "tiers": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "input",
                    "output"
                  ],
                  "properties": {
                    "input": {
                      "type": "number",
                      "minimum": 0
                    },
                    "output": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cached_input": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cache_write_30m": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cache_write_12h": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cache_write_5m": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cache_write_1h": {
                      "type": "number",
                      "minimum": 0
                    },
                    "long": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "above",
                        "input",
                        "output"
                      ],
                      "properties": {
                        "above": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "input": {
                          "type": "number",
                          "minimum": 0
                        },
                        "output": {
                          "type": "number",
                          "minimum": 0
                        },
                        "cached_input": {
                          "type": "number",
                          "minimum": 0
                        },
                        "cache_write_30m": {
                          "type": "number",
                          "minimum": 0
                        },
                        "cache_write_12h": {
                          "type": "number",
                          "minimum": 0
                        },
                        "cache_write_5m": {
                          "type": "number",
                          "minimum": 0
                        },
                        "cache_write_1h": {
                          "type": "number",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              },
              "long": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "above",
                  "input",
                  "output"
                ],
                "properties": {
                  "above": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "input": {
                    "type": "number",
                    "minimum": 0
                  },
                  "output": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cached_input": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cache_write_30m": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cache_write_12h": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cache_write_5m": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cache_write_1h": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "description": "[agent.prices]: flat, by model name."
        },
        "file_prices": {
          "type": "object",
          "description": "The team's scrimmage-runs/prices.toml: its rows for each provider, by provider name and then model name.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input",
                "output"
              ],
              "properties": {
                "input": {
                  "type": "number",
                  "minimum": 0
                },
                "output": {
                  "type": "number",
                  "minimum": 0
                },
                "cached_input": {
                  "type": "number",
                  "minimum": 0
                },
                "cache_write_30m": {
                  "type": "number",
                  "minimum": 0
                },
                "cache_write_12h": {
                  "type": "number",
                  "minimum": 0
                },
                "web_search_request": {
                  "type": "number",
                  "minimum": 0
                },
                "cache_write_5m": {
                  "type": "number",
                  "minimum": 0
                },
                "cache_write_1h": {
                  "type": "number",
                  "minimum": 0
                },
                "tiers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "input",
                      "output"
                    ],
                    "properties": {
                      "input": {
                        "type": "number",
                        "minimum": 0
                      },
                      "output": {
                        "type": "number",
                        "minimum": 0
                      },
                      "cached_input": {
                        "type": "number",
                        "minimum": 0
                      },
                      "cache_write_30m": {
                        "type": "number",
                        "minimum": 0
                      },
                      "cache_write_12h": {
                        "type": "number",
                        "minimum": 0
                      },
                      "cache_write_5m": {
                        "type": "number",
                        "minimum": 0
                      },
                      "cache_write_1h": {
                        "type": "number",
                        "minimum": 0
                      },
                      "long": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "above",
                          "input",
                          "output"
                        ],
                        "properties": {
                          "above": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "input": {
                            "type": "number",
                            "minimum": 0
                          },
                          "output": {
                            "type": "number",
                            "minimum": 0
                          },
                          "cached_input": {
                            "type": "number",
                            "minimum": 0
                          },
                          "cache_write_30m": {
                            "type": "number",
                            "minimum": 0
                          },
                          "cache_write_12h": {
                            "type": "number",
                            "minimum": 0
                          },
                          "cache_write_5m": {
                            "type": "number",
                            "minimum": 0
                          },
                          "cache_write_1h": {
                            "type": "number",
                            "minimum": 0
                          }
                        }
                      }
                    }
                  }
                },
                "long": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "above",
                    "input",
                    "output"
                  ],
                  "properties": {
                    "above": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "input": {
                      "type": "number",
                      "minimum": 0
                    },
                    "output": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cached_input": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cache_write_30m": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cache_write_12h": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cache_write_5m": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cache_write_1h": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "file_fees": {
          "type": "object",
          "description": "The team's scrimmage-runs/prices.toml: its [provider.fees] for each provider, by provider name and then fee, in dollars for each request.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "service_tier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "record": {
      "type": "boolean"
    },
    "probe": {
      "type": "boolean"
    },
    "scrub": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 8
      },
      "description": "The values ${NAME} filled in, of 8 characters or more. The SDK removes each from every line and side-folder item, in its encoded forms too, before either is hashed. Sent with the plan only: never written to a file."
    },
    "service": {
      "type": "boolean",
      "description": "A run of an agent inside a web service: one request long."
    },
    "record_grace_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 60,
      "description": "In a service run: how long the record stays open after the reply."
    },
    "background_real": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "In a service run: labels that calls made outside any request may run for real while the run is open. Never read for a call inside the run, which real decides."
    }
  },
  "$defs": {
    "tool_label": {
      "type": "string",
      "pattern": "^tool:[A-Za-z0-9_-]+$"
    },
    "import_path": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "model_label": {
      "type": "string",
      "pattern": "^model(:(openai|anthropic|\\*)(/(embeddings|moderations|input_tokens))?)?$"
    },
    "call_label": {
      "anyOf": [
        {
          "$ref": "#/$defs/tool_label"
        },
        {
          "$ref": "#/$defs/model_label"
        },
        {
          "$ref": "#/$defs/web_label"
        },
        {
          "$ref": "#/$defs/mcp_label"
        }
      ]
    },
    "mcp_label": {
      "type": "string",
      "pattern": "^mcp:[^*]+$"
    },
    "web_label": {
      "type": "string",
      "pattern": "^http:[a-f0-9:.]*:[a-f0-9:.]*$|^http:[a-z0-9][a-z0-9._-]*$"
    }
  }
}
