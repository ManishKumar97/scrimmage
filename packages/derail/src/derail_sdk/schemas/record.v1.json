{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:derail:schema:record:v1",
  "title": "Derail record line, version 1",
  "description": "One line of a run's JSON Lines record: a call, or the summary that ends the record.",
  "oneOf": [
    {
      "$ref": "#/$defs/call"
    },
    {
      "$ref": "#/$defs/summary"
    },
    {
      "$ref": "#/$defs/notice"
    }
  ],
  "$defs": {
    "head": {
      "type": "object",
      "required": [
        "v",
        "run",
        "test",
        "row"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "run": {
          "type": "string",
          "minLength": 1
        },
        "test": {
          "type": "string",
          "minLength": 1
        },
        "row": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes",
        "preview"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "preview": {
          "type": "string",
          "maxLength": 200
        },
        "cut": {
          "const": true
        },
        "unsaved": {
          "const": true
        }
      }
    },
    "call": {
      "allOf": [
        {
          "$ref": "#/$defs/head"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "seq",
        "proc",
        "call",
        "kind",
        "action",
        "args",
        "result",
        "error",
        "start",
        "ms"
      ],
      "properties": {
        "v": true,
        "run": true,
        "test": true,
        "row": true,
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "proc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "pid",
            "started"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "pid": {
              "type": "integer"
            },
            "started": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "call": {
          "type": "string",
          "pattern": "^(tool:[A-Za-z0-9_-]+|model:[a-z*]+(/[a-z_]+)?|http:.+|mcp:.+|process:python)$"
        },
        "kind": {
          "enum": [
            "tool",
            "model",
            "http",
            "mcp",
            "process"
          ]
        },
        "action": {
          "enum": [
            "real",
            "mock",
            "fault",
            "refused"
          ]
        },
        "fault": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "do",
            "when",
            "n"
          ],
          "properties": {
            "do": {
              "type": "string",
              "pattern": "^(timeout|error|empty|status [45][0-9]{2})$"
            },
            "when": {
              "type": "string",
              "pattern": "^(always|(first|requests) [1-9][0-9]*)$"
            },
            "n": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "args": {
          "$ref": "#/$defs/content"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/content"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "mistake": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "ms": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "enum": [
            "unlisted",
            "poisoned",
            "budget",
            "no_price",
            "hosted",
            "unknown_tool_type",
            "unseen_tool",
            "web_write",
            "control_unreachable",
            "unreadable_body",
            "unreadable_model",
            "redirect_off_host",
            "unsupported_loop",
            "ambiguous_label",
            "blind_child",
            "no_plan"
          ]
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "retry": {
          "type": "integer",
          "minimum": 0
        },
        "forwarded_to": {
          "type": "string"
        },
        "near_mock": {
          "const": true
        },
        "mock": {
          "type": "integer",
          "minimum": 0
        },
        "stream": {
          "type": "boolean"
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "output",
            "cached"
          ],
          "properties": {
            "input": {
              "type": "integer",
              "minimum": 0
            },
            "output": {
              "type": "integer",
              "minimum": 0
            },
            "cached": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_estimated": {
          "type": "boolean"
        },
        "reply_incomplete": {
          "const": true
        },
        "unseen_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hosted_reads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "allOf": [
        {
          "$ref": "#/$defs/head"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "v": true,
        "run": true,
        "test": true,
        "row": true,
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answer",
            "outcome",
            "fault_fired",
            "calls",
            "incomplete",
            "model_calls",
            "cost_usd",
            "judged",
            "broken_rules",
            "left_out"
          ],
          "properties": {
            "answer": {
              "type": [
                "string",
                "null"
              ]
            },
            "outcome": {
              "enum": [
                "answered",
                "crashed",
                "timed out",
                "refused call",
                "budget reached",
                "infrastructure error",
                "stopped"
              ]
            },
            "fault_fired": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "calls": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "real",
                "mock",
                "fault",
                "refused"
              ],
              "properties": {
                "real": {
                  "type": "integer",
                  "minimum": 0
                },
                "mock": {
                  "type": "integer",
                  "minimum": 0
                },
                "fault": {
                  "type": "integer",
                  "minimum": 0
                },
                "refused": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "incomplete": {
              "type": "boolean"
            },
            "model_calls": {
              "type": "integer",
              "minimum": 0
            },
            "cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "judged": {
              "enum": [
                "pass",
                "fail",
                "left out"
              ]
            },
            "broken_rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "text"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "expect",
                      "forbid",
                      "empty",
                      "crashed",
                      "timed out",
                      "refused"
                    ]
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            },
            "left_out": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "notice": {
      "allOf": [
        {
          "$ref": "#/$defs/head"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "seq",
        "proc",
        "notice",
        "library",
        "message"
      ],
      "properties": {
        "v": true,
        "run": true,
        "test": true,
        "row": true,
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "proc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "pid",
            "started"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "pid": {
              "type": "integer"
            },
            "started": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "notice": {
          "enum": [
            "structure",
            "newer_version",
            "tools_seen",
            "answer_path",
            "process",
            "other_python",
            "left_group"
          ]
        },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "python",
            "command",
            "parent"
          ],
          "properties": {
            "python": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "parent": {
              "type": "integer"
            }
          }
        },
        "library": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "mistake": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
